# This root file is informational only.
# ContributorOps reads env vars from workspace-specific files:
# - apps/api/.env
# - apps/web/.env.local
# - apps/site/.env.local
#
# Full setup guide:
# docs/environment-setup.md

# apps/api/.env
PORT=8787
PUBLIC_APP_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:5174,http://localhost:8787

GITHUB_TOKEN=
GITHUB_USERNAME=
GH_CONTRIBUTOROPS_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

CONTRIBUTOROPS_OWNER=AnkitParekh007
CONTRIBUTOROPS_REPO=contributorOps

AUTO_CONTRIBUTE_ENABLED=false
AUTO_PR_DAILY_LIMIT=3
AUTO_COMMENT_DAILY_LIMIT=5
CREATE_DAILY_ISSUE=false

STORAGE_MODE=demo
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
TOKEN_ENCRYPTION_KEY=
LOG_LEVEL=debug

# apps/web/.env.local
VITE_API_BASE_URL=http://localhost:8787
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# apps/site/.env.local
# VITE_API_BASE_URL=http://localhost:8787
