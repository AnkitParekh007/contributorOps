# ContributorOps Site — Environment Variables
# The site is a static build — most config is baked in at build time.
# Copy this to .env for local development overrides.

# Set to true once payments are wired (removes the "payments not live" callout)
VITE_BILLING_LIVE=false

# ── Future (Phase 3+) ──────────────────────────────────────────
