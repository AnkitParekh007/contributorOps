# ContributorOps Web App — Environment Variables
# Copy this to .env and fill in your values.

# API base URL (the Express API server)
VITE_API_BASE_URL=http://localhost:8787

# ── Phase 3: Supabase Auth ────────────────────────────────────────────────────
# Add these to enable real auth. Without them, the app runs in demo mode.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ── Phase 8: Analytics ────────────────────────────────────────────────────────
# VITE_POSTHOG_KEY=your_posthog_project_key
