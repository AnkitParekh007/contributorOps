# ContributorOps API — Environment Variables
# Copy this to .env and fill in your values.

# Server
PORT=8787

# GitHub Integration (optional — demo mode works without these)
GITHUB_TOKEN=ghp_your_token_here
GITHUB_USERNAME=your_github_username
GH_CONTRIBUTOROPS_TOKEN=ghp_your_planning_issue_token

# Target repository for planning issues (optional)
CONTRIBUTOROPS_OWNER=AnkitParekh007
CONTRIBUTOROPS_REPO=contributorOps

# Contribution safety limits
AUTO_CONTRIBUTE_ENABLED=false
AUTO_PR_DAILY_LIMIT=3
AUTO_COMMENT_DAILY_LIMIT=5
CREATE_DAILY_ISSUE=false

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4174

# App URL (used for public portfolio links)
PUBLIC_APP_URL=http://localhost:8787

# ── Phase 3: Database + Auth (Supabase) ───────────────────────────────────────
# STORAGE_MODE=demo        # 'demo' uses local JSON (default) | 'supabase' uses Postgres
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your_service_role_key_here
# TOKEN_ENCRYPTION_KEY=64_hex_chars_minimum_for_aes256_gcm

# GitHub OAuth App (for Supabase Auth GitHub provider)
# GITHUB_CLIENT_ID=your_oauth_app_client_id
# GITHUB_CLIENT_SECRET=your_oauth_app_client_secret
